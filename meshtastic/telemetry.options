# options for nanopb
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

*LocalStats.num_online_nodes int_size:16
*LocalStats.num_total_nodes int_size:16
*LocalStats.num_tx_dropped int_size:16
*LocalStats.discovery_stage int_size:8
*LocalStats.discovery_servers int_size:8

*Telemetry.variant anonymous_oneof:true

*DeviceMetrics.voltage int_size:16
*DeviceMetrics.channel_utilization int_size:16
*DeviceMetrics.air_util_tx int_size:16

*HostMetrics.load1 int_size:16
*HostMetrics.load5 int_size:16
*HostMetrics.load15 int_size:16
# 161 keeps a full HostMetrics small enough for one frame in the common case; the
# room a frame leaves is computed per packet (SCHEMA.md §8, Payload room).
*HostMetrics.user_string max_size:161

# Sensor readings. The arrays sit on three different axes: keys and sensors are per
# quantity, time_deltas and present are per sample, values is per reading. The encoder
# fills a message until the frame has no room left and sends the rest in the next one,
# so these bounds only need to hold what one frame can carry: a reading costs at least
# two bytes (key and value) and a typical one three to five, so 64 columns, 128 values
# and 64 samples are past what the room allows in practice. The encoder stops at a
# bound too, whichever comes first, and a decoder accepts anything an encoder sends.
#
# max_count is also what makes these packed. Without it nanopb emits a callback field,
# and a callback writes a tag per element - which is exactly the per-reading framing
# the columnar layout exists to remove.
#
# values must stay 32-bit: barometric pressure in pascals already exceeds 16 bits.
*SensorReadings.keys max_count:64
*SensorReadings.keys int_size:16
*SensorReadings.values max_count:128
# time_deltas has one entry per sample after the first, whose time is Telemetry.time;
# present has ceil(keys / 32) words per sample.
*SensorReadings.time_deltas max_count:64
*SensorReadings.time_deltas int_size:32
*SensorReadings.present max_count:64
*SensorReadings.present int_size:32
*SensorReadings.sensors max_count:64
*SensorReadings.sensors int_size:8

# A 24-bit ADC tare, signed: needs the full width.
*Nau7802Config.zeroOffset int_size:32
