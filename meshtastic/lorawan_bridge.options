# A bridged PHY payload is one LoRa frame, so its buffer is capped at the frame,
# 256 bytes. A packet too large for the room a frame leaves is fragmented by the v3
# header (SCHEMA.md §8, Payload room).
*LoRaWANBridge.Uplink.rssi_x10 int_size:16
*LoRaWANBridge.Uplink.snr_x10 int_size:16
*LoRaWANBridge.Uplink.radio_params int_size:8
*LoRaWANBridge.Uplink.fsk_bitrate int_size:16
*LoRaWANBridge.Uplink.payload max_size:256

*LoRaWANBridge.Downlink.radio_params int_size:8
*LoRaWANBridge.Downlink.power_dbm int_size:8
*LoRaWANBridge.Downlink.request_id int_size:8
*LoRaWANBridge.Downlink.payload max_size:256

*LoRaWANBridge.TxResult.request_id int_size:8

*LoRaWANBridge.variant anonymous_oneof:true

*LoRaWANBridge.Downlink.flags int_size:8
