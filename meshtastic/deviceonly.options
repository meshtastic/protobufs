# options for nanopb
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

# This array IS the channel count. mesh-pb-constants.h derives MAX_NUM_CHANNELS
# from sizeof(channels) / sizeof(channels[0]), so the number here is what makes
# the device a 16-channel device. 1096 bytes of RAM at 16, against 552 at 8 and
# 1640 at 24. Firmware fills the array to capacity, so every node pays for all
# sixteen whether it uses them or not - see the dynamic allocation note in
# SCHEMA.md section 10.
*ChannelFile.channels max_count:16

*DeviceState.node_remote_hardware_pins max_count:12

*NodeInfoLite.channel int_size:8
*NodeInfoLite.hops_away int_size:8
*NodeInfoLite.next_hop int_size:8

# Flattened user fields. 24 bytes is the name limit devices enforce; 25 leaves room
# for the terminator and gives back ~15 B/node of RAM against the old 40.
*NodeInfoLite.long_name max_size:25
*NodeInfoLite.short_name max_size:5
*NodeInfoLite.public_key max_size:32
# role is pinned to one byte to claw back alignment overhead. hw_model needs two:
# it is the packed (vendor_id << 8) | device_id value, so it spans 16 bits.
*NodeInfoLite.hw_model int_size:16
*NodeInfoLite.role int_size:8
# NodeFlags reaches bit 10 (NODE_FLAG_HAS_SNR), so this needs 16 bits. It was
# pinned to 8 when the field held only two flags; the upstream flattening grew it
# past a byte.
*NodeInfoLite.bitfield int_size:16
*PositionLite.precision_bits int_size:8