# longest current is 45 chars, plan with a bit of buffer
*DeviceConfig.tzdef max_size:65
*DeviceConfig.buzzer_mode int_size:8


*NetworkConfig.wifi_ssid max_size:33
*NetworkConfig.wifi_psk max_size:65
*NetworkConfig.ntp_server max_size:33
*NetworkConfig.rsyslog_server max_size:33

# Max of three ignored nodes for our testing

*LoRaConfig.tx_power int_size:8
*LoRaConfig.bandwidth int_size:16
*LoRaConfig.coding_rate int_size:8
*LoRaConfig.channel_num int_size:16
*LoRaConfig.fem_lna_mode int_size:8

*PowerConfig.device_battery_ina_address int_size:8

*SecurityConfig.public_key max_size:32
*SecurityConfig.ratchet_flags int_size:8
# One X25519 private key per group a node serves, matching GroupConfig.groups.
*SecurityConfig.group_private_key max_count:4
*SecurityConfig.group_private_key max_size:32
*SecurityConfig.private_key max_size:32
*SecurityConfig.admin_key max_size:32
*SecurityConfig.admin_key max_count:3
*SecurityConfig.packet_signature_policy int_size:8

*ConfigPayload.payload_variant anonymous_oneof:true

# Packed boolean flags. LoRaConfig reaches bit 7 and DisplayConfig bit 5, so all
# of these stay inside a byte.
*DeviceConfig.flags int_size:8
*NetworkConfig.flags int_size:8
*DisplayConfig.flags int_size:8
*LoRaConfig.flags int_size:8
*SecurityConfig.flags int_size:8

# One rule per channel the node holds, plus room for hashes it does not.
*RelayConfig.rules max_count:16
*RelayConfig.Rule.channel_hash int_size:8
*RelayConfig.Rule.hop_cap int_size:8
# Region names, as in HeaderOptions.scope_code.
*RelayConfig.regions max_count:4
*RelayConfig.regions max_size:16

# A node serving more than a handful of groups is a different design.
*GroupConfig.groups max_count:4
*GroupConfig.Group.name max_size:12
# X25519 keys, as SecurityConfig's.
*GroupConfig.Group.public_key max_size:32
