# nanopb options for packet.proto
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

# One frame's worth: no LoRa frame is longer than 256 bytes, so no ciphertext is.
*MeshPacket.encrypted max_size:256
*MeshPacket.public_key max_size:32
*MeshPacket.payload_variant anonymous_oneof:true
*MeshPacket.hop_limit int_size:8
*MeshPacket.hop_start int_size:8
*MeshPacket.channel int_size:8
*MeshPacket.channel_hash int_size:8
*MeshPacket.next_hop int_size:8
*MeshPacket.relay_node int_size:8
*MeshPacket.priority int_size:8

# The options block's length is the one-byte opt_len in the on-air header.
*MeshPacket.header_options max_size:255
*MeshPacket.flags int_size:8

# One byte per hop between from and relay: at most 15 hops taken, less the last.
*MeshPacket.path max_size:14
