# nanopb options for wire.proto
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

*id max_size:16 # node id strings
*public_key max_size:32 # public key

# 24 bytes is the name limit devices enforce, so 25 covers it with the terminator.
# The old 40-byte decode width existed to accept names from 2.x senders built
# against the 39-byte limit; 3.0 is wire-incompatible with 2.x anyway, so that
# allowance bought nothing. Matches NodeInfoLite.long_name in deviceonly.options.
*User.long_name max_size:25
*User.short_name max_size:5

*RouteDiscovery.route max_count:8
*RouteDiscovery.snr_towards max_count:8
*RouteDiscovery.snr_towards int_size:8
*RouteDiscovery.route_back max_count:8
*RouteDiscovery.snr_back max_count:8
*RouteDiscovery.snr_back int_size:8

# note: this payload length is ONLY the bytes that are sent inside of the Data protobuf (excluding protobuf overhead). The 16 byte header is
# outside of this envelope
*Data.payload max_size:233
*Data.bitfield int_size:8
*Data.xeddsa_signature max_size:64

*Routing.variant anonymous_oneof:true

*Position.latitude_variant anonymous_oneof:true
*Position.longitude_variant anonymous_oneof:true
*Position.fix_quality int_size:8
*Position.fix_type int_size:8
*Position.sats_in_view int_size:8
*Position.sensor_id int_size:8
*Position.precision_bits int_size:8


*KeyVerification.hash1 max_size:32
*KeyVerification.hash2 max_size:32

*StoreForwardPlusPlus.message_hash max_size:32
*StoreForwardPlusPlus.commit_hash max_size:32
*StoreForwardPlusPlus.root_hash max_size:32
*StoreForwardPlusPlus.message max_size:240

*RemoteShell.payload max_size:200
*RemoteShell.op int_size:8
# Turn-taking bits only (GRANT/MORE/RTS).
*RemoteShell.flags int_size:8
# cols/rows land in struct winsize, whose members are unsigned short.
*RemoteShell.cols int_size:16
*RemoteShell.rows int_size:16
# seq, ack_seq, last_tx_seq and last_rx_seq stay 32-bit: they are monotonic
# per-session counters and a long interactive session can pass 65535 frames.

*StatusMessage.status max_size:80

#This value may want to be a few bytes smaller to compensate for the parent fields.
*Compressed.data max_size:233

*Waypoint.name         max_size:30
*Waypoint.description  max_size:100
*Waypoint.notify_flags int_size:8

*NeighborInfo.neighbors max_count:10
*Neighbor.node_broadcast_interval_secs int_size:16

*MqttClientProxyMessage.topic max_size:60
*MqttClientProxyMessage.data max_size:435
*MqttClientProxyMessage.text max_size:435
*MqttClientProxyMessage.payload_variant anonymous_oneof:true

# ext_len is a single byte in the on-air header, so the encoded block cannot exceed
# 255; keeping it one byte keeps the relay bounds check a single comparison.
*HeaderExt.source_route max_size:7
