# nanopb options for api.proto
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

*NodeInfo.channel int_size:8
*NodeInfo.hops_away int_size:8
# NodeFlags reaches bit 9 (NODE_FLAG_HAS_XEDDSA_SIGNED) here, so 16 bits.
*NodeInfo.flags int_size:16

*MyNodeInfo.device_id max_size:16
*MyNodeInfo.pio_env max_size:40
*MyNodeInfo.firmware_edition int_size:8
*MyNodeInfo.nodedb_count int_size:16

*QueueStatus.res int_size:8
*QueueStatus.free int_size:8
*QueueStatus.maxlen int_size:8

*ToRadio.payload_variant anonymous_oneof:true
*FromRadio.payload_variant anonymous_oneof:true

*LogRecord.message max_size:384
*LogRecord.source max_size:32

*FileInfo.file_name max_size:228

*ClientNotification.message max_size:400
*ClientNotification.payload_variant anonymous_oneof:true

# Mirrors User.long_name, which these carry a copy of.
*KeyVerificationNumberInform.remote_longname max_size:25
*KeyVerificationNumberRequest.remote_longname max_size:25
*KeyVerificationFinal.remote_longname max_size:25
*KeyVerificationFinal.verification_characters max_size:10

*DeviceMetadata.firmware_version max_size:18
*DeviceMetadata.capabilities int_size:8
*DeviceMetadata.role int_size:8

*ChunkedPayload.chunk_count int_size:16
*ChunkedPayload.chunk_index int_size:16
*ChunkedPayload.payload_chunk max_size:228

*ChunkedPayloadResponse.payload_variant anonymous_oneof:true

# Region->preset compatibility map (FromRadio.region_presets). groups is capped
# above the current table (6 distinct preset groups); region_groups at 38 = the
# number of RegionCode values, so it can never overflow however many regions gain
# a firmware table entry. Worst case is ~120 bytes, well inside the 512-byte
# MAX_TO_FROM_RADIO_SIZE cap on FromRadio.
*LoRaRegionPresetMap.groups        max_count:8
*LoRaRegionPresetMap.region_groups max_count:38
*LoRaRegionPresetMap.region_groups int_size:8
*LoRaPresetGroup.default_preset    int_size:8

*LockdownStatus.state int_size:8
*LockdownStatus.lock_reason int_size:8
*LockdownStatus.boots_remaining int_size:16
